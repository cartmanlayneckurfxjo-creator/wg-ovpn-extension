{
  "manifest_version": 3,
  "name": "WG & OpenVPN Proxy",
  "version": "0.1.0",
  "description": "Connect WireGuard (.conf) and OpenVPN (.ovpn) profiles via local Native Messaging tunnel.",
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WG & OpenVPN Proxy"
  }
}
